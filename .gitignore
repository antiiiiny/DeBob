dist/

# Dependencies
node_modules/

# DeBob knowledge graph -- deliberately COMMITTED so anyone cloning this repo can run
# `debob visualise` immediately, with no API key and no IBM Cloud account. It is verified to
# contain no author emails, credentials or raw source. See docs/bob-sessions/README.md.
# The enrichment export file is a transient work product of `debob enrich --export`, not context.
.debob/enrichment.json
.claude/

